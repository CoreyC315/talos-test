machine:
  network:
    hostname: ${hostname}
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
        addresses:
          - ${ip}/24
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
%{ if is_controlplane ~}
        vip:
          ip: ${vip}
%{ endif ~}
  nodeLabels:
    topology.kubernetes.io/region: homelab
    topology.kubernetes.io/zone: ${zone}
---
# Talos 1.13 emits a separate HostnameConfig document; with machine.network.hostname ALSO set
# above, apply fails ("static hostname is already set in v1alpha1 config"). Delete the generated
# HostnameConfig so the v1alpha1 hostname is the single source of truth (matches the static
# talos/patches/nodes/*.yaml used by the manual path).
apiVersion: v1alpha1
kind: HostnameConfig
$patch: delete
